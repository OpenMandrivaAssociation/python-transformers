+        model += [WavTokenizerLSTM(config, scaling * config.num_filters)]
+        model += [nn.ELU()]
+        model += [
+            WavTokenizerConv1d(config, scaling * config.num_filters, config.hidden_size, config.last_kernel_size)
+        ]
+
+        self.layers = nn.ModuleList(model)
+
+    def forward(self, hidden_states):
+        for layer in self.layers:
+            hidden_states = layer(hidden_states)
+        return hidden_states
