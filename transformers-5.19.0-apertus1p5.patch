+
+        # Downsample to raw audio scale
+        for ratio in reversed(config.upsampling_ratios):
+            current_scale = scaling * config.num_filters
+            # Add residual layers
+            for j in range(config.num_residual_layers):
+                model += [WavTokenizerResnetBlock(config, current_scale, [config.dilation_growth_rate**j, 1])]
+            # Add downsampling layers
+            model += [nn.ELU()]
+            model += [
+                WavTokenizerConv1d(config, current_scale, current_scale * 2, kernel_size=ratio * 2, stride=ratio)
+            ]
+            scaling *= 2
